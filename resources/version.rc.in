#include <winver.h>

1 VERSIONINFO
FILEVERSION @HOST_VERSION_NUMERIC@
PRODUCTVERSION @HOST_VERSION_NUMERIC@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @HOST_FILE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mfweb\0"
            VALUE "FileDescription", "@HOST_DESCRIPTION@\0"
            VALUE "FileVersion", "@HOST_VERSION@.0\0"
            VALUE "InternalName", "@HOST_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright (c) Mfweb\0"
            VALUE "OriginalFilename", "@HOST_FILENAME@\0"
            VALUE "ProductName", "@HOST_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@HOST_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
